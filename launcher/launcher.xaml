         </StackPanel>
        </HeaderedContentControl>
       </StackPanel></ScrollViewer></TabItem>
       <TabItem Header="WORKSHOP"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
