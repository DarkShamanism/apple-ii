     <DockPanel>
      <WrapPanel DockPanel.Dock="Top"><Button Name="CpmSave" Tag="V" Content="SAVE PROFILE"/><Button Name="CpmStop" Tag="X" Content="STOP / RELEASE PORT"/><Button Name="CpmGuide" Tag="G" Content="SOFTCARD GUIDE"/></WrapPanel>
