          <TextBlock Style="{StaticResource Note}" Text="Terminal output appears in the journal below. This is a plain text terminal, not a VT100 emulator. Stop it before using helper actions or sending HEX."/>
         </StackPanel>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource Frame}" Header="DISKLESS SOFTCARD PROBE / NO CP/M DISK NEEDED" BorderBrush="{DynamicResource C3}" Margin="0,12,0,0">
         <StackPanel>
          <TextBlock Margin="0,0,0,8" Text="Close ADTPro. At the Apple's ] prompt type IN# and the SSC slot, Return, then Ctrl+A, 14B, Return (9600 baud). Then probe the SoftCard. It loads a probe into RAM at $6000 through the monitor, tests the card's memory windows, Z80 start, hold, speed and request handshake, and saves a report. Uses the port above at 9600 whatever baud is selected."/>
          <UniformGrid Columns="3"><StackPanel Margin="0,0,16,0"><TextBlock Text="SSC SLOT"/><ComboBox Name="CpmSlotField"/></StackPanel></UniformGrid>
          <WrapPanel><Button Name="CpmCardProbe" Tag="R" Content="PROBE SOFTCARD (RAM, NO DISK)" Style="{StaticResource Primary}"/></WrapPanel>
          <TextBlock Style="{StaticResource Note}" Text="Power-cycle the Apple afterwards: the probe overwrites aux RAM and the language card and leaves the Z80 in reset."/>
         </StackPanel>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource Frame}" Header="BOOT CP/M FROM THE PC / NO DISK DRIVE NEEDED" BorderBrush="{DynamicResource C5}" Margin="0,12,0,0">
         <StackPanel>
          <TextBlock Margin="0,0,0,8" Text="Boots Premium SoftCard IIe CP/M 2.26B from the disk image chosen on the Library page (drive A:), with the port and SSC slot above. Close ADTPro, then at the ] prompt type IN# and the slot, Return, Ctrl+A, 14B, Return. The launcher loads a small bootstrap through the monitor and then serves every CP/M disk read and write until you stop it."/>
          <TextBlock Text="DRIVE B: IMAGE (OPTIONAL)"/><TextBox Name="CpmDiskBField"/>
          <UniformGrid Columns="3"><StackPanel Margin="0,0,16,0"><TextBlock Text="DISK LINK BAUD"/><ComboBox Name="CpmBootBaudField"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="CP/M WRITES"/><ComboBox Name="CpmWritesField"/></StackPanel></UniformGrid>
          <WrapPanel Margin="0,10,0,0"><Button Name="CpmBootPc" Tag="B" Content="BOOT CP/M FROM PC" Style="{StaticResource Primary}"/><Button Name="CpmBrowseDiskB" Tag="D" Content="CHOOSE B: DISK"/></WrapPanel>
          <TextBlock Style="{StaticResource Note}" Text="Writes go straight to the images; each is backed up first to build\&lt;version&gt;\launcher\cpm-backups. While CP/M runs, the SSC carries the disks: CP/M sees no card in its slot. Stop / release port ends the session; the Apple then reports disk errors."/>
         </StackPanel>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource Frame}" Header="FIRST-TIME HELPER INSTALLATION / PIP + LOAD" BorderBrush="{DynamicResource C1}" Margin="0,12,0,0">
         <StackPanel>
          <TextBlock Margin="0,0,0,8" Text="On the Apple, configure RDR: for SSC input, then run PIP A2Z.HEX=RDR:. Once PIP is waiting, select this release's A2Z.HEX and send it. When it finishes, run LOAD A2Z. Then A2Z runs local diagnostics; A2Z R starts the remote helper."/>
          <TextBox Name="CpmHexField"/>
          <WrapPanel><Button Name="CpmBrowseHex" Tag="O" Content="CHOOSE HEX"/><Button Name="CpmSendHex" Tag="P" Content="SEND HEX TO WAITING PIP"/><Button Name="CpmHelperHex" Tag="U" Content="USE THIS RELEASE'S HELPER"/></WrapPanel>
          <TextBlock Style="{StaticResource Note}" Text="HEX sends are paced and unacknowledged: verify LOAD's result on the Apple. Run uses a checksummed, read-back-verified RAM module instead. Closing the PC port does not exit A2Z R; use Exit helper or restart on the Apple after an interrupted packet."/>
         </StackPanel>
        </HeaderedContentControl>
       </StackPanel></ScrollViewer></TabItem>
      </TabControl>
     </DockPanel>
    </TabItem>

    <TabItem Header="7 CASSETTE" Name="TapeTab">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
       <StackPanel>
        <HeaderedContentControl Style="{StaticResource Frame}" Header="TAPE SHELF" BorderBrush="{DynamicResource C1}">
         <ListBox Name="TapeLibraryList" MaxHeight="220" DisplayMemberPath="Title"/>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource Frame}" Header="TAPE DETAILS" BorderBrush="{DynamicResource C4}" Margin="0,12,0,0">
         <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="TITLE" VerticalAlignment="Center"/><Line Grid.Column="1" Style="{StaticResource Leader}"/><TextBox Grid.Column="2" Name="TapeTitleField"/></Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="ON THE APPLE" VerticalAlignment="Center"/><Line Grid.Column="1" Style="{StaticResource Leader}"/><TextBox Grid.Column="2" Name="TapeLoadField"/></Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="NOTES" VerticalAlignment="Center"/><Line Grid.Column="1" Style="{StaticResource Leader}"/><TextBox Grid.Column="2" Name="TapeNotesField" TextWrapping="Wrap"/></Grid>
          <TextBlock Name="TapeLengthText" Text="-" Foreground="{DynamicResource Dim}" Margin="0,6,0,0"/>
          <TextBlock Name="TapeDetail" Foreground="{DynamicResource Dim}" Text="Choose a tape from the shelf, add a file or download one." Margin="0,4,0,10"/>
          <WrapPanel><Button Name="TapeSave" Tag="S" Content="SAVE TO LIBRARY"/><Button Name="TapeRemove" Tag="R" Content="REMOVE"/><Button Name="TapeFolder" Tag="F" Content="OPEN FOLDER"/></WrapPanel>
          <TextBlock Style="{StaticResource Note}" Text="Removing an entry keeps its audio file."/>
         </StackPanel>
        </HeaderedContentControl>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <HeaderedContentControl Style="{StaticResource FrameDouble}" Header="PLAYER / CASSETTE IN" BorderBrush="{DynamicResource C2}">
         <StackPanel>
          <WrapPanel><TextBlock Text="ON THE APPLE, TYPE:" Foreground="{DynamicResource Dim}" Margin="0,0,12,0" VerticalAlignment="Center"/><Border Background="{DynamicResource Sel}" Padding="10,2"><TextBlock Name="TapeLoadBig" Text="LOAD" Foreground="{DynamicResource OnSel}" FontSize="28"/></Border></WrapPanel>
          <DockPanel Margin="0,14,0,8"><TextBlock Name="TapePosition" DockPanel.Dock="Right" Text="0:00" Width="130" TextAlignment="Right" VerticalAlignment="Center"/><ProgressBar Name="TapeProgress" Height="24" Minimum="0" Maximum="1"/></DockPanel>
          <DockPanel Margin="0,0,0,10"><TextBlock Text="PLAYER VOLUME" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBlock Name="TapeVolumeText" DockPanel.Dock="Right" Text="100%" Width="64" TextAlignment="Right" VerticalAlignment="Center"/><Slider Name="TapeVolume" Minimum="0" Maximum="100" Value="100"/></DockPanel>
          <WrapPanel><Button Name="TapePlay" Tag="P" Content="PLAY TO CASSETTE IN" Style="{StaticResource Primary}"/><Button Name="TapeStop" Tag="X" Content="STOP PLAYBACK"/></WrapPanel>
          <TextBlock Style="{StaticResource Note}" Text="Play checks the file's SHA-256 first. Stopping part-way leaves the Apple waiting or with a partial load; press Ctrl-Reset and start again."/>
         </StackPanel>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource Frame}" Header="BEFORE YOU PRESS PLAY" BorderBrush="{DynamicResource C3}" Margin="0,12,0,0">
         <StackPanel>
          <TextBlock Text="1. Cable from the PC's headphone or line out to the IIe's cassette IN jack, not OUT. Bluetooth, HDMI and USB headsets will not reach it.&#10;2. Windows volume near maximum, player at 100%. Audio enhancements and notification sounds off.&#10;3. On the IIe: no disks, Ctrl-Reset, type the load command, press Return. No DOS may be booted for LOAD.&#10;4. Press P here. Most loads take 10 to 30 seconds and start by themselves."/>
          <Button Name="TapeGuide" Tag="G" Content="CASSETTE GUIDE" HorizontalAlignment="Left" Margin="0,12,0,8"/>
          <TextBlock Style="{StaticResource Note}" Text="The IIc and IIgs have no cassette input. An original Apple II uses 800.A00R 800G for game server tapes."/>
         </StackPanel>
        </HeaderedContentControl>
       </StackPanel>
      </Grid>
      <HeaderedContentControl Style="{StaticResource Frame}" Header="ADD TAPES / ASCII EXPRESS GAME SERVER" BorderBrush="{DynamicResource C5}" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Margin="0,0,0,8" Text="Open the game server in your browser, copy a game's audio link, paste it here and download it once. Downloads stay in this release's build folder, so later plays work offline. Local WAV, AIFF and MP3 files can be added too."/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="AUDIO LINK (HTTPS)" VerticalAlignment="Center"/><Line Grid.Column="1" Style="{StaticResource Leader}"/><TextBox Grid.Column="2" Name="TapeUrlField"/></Grid>
        <WrapPanel><Button Name="TapeOpenServer" Tag="O" Content="OPEN GAME SERVER"/><Button Name="TapeDownload" Tag="W" Content="DOWNLOAD TO LIBRARY" Style="{StaticResource Primary}"/><Button Name="TapeCancel" Tag="C" Content="CANCEL DOWNLOAD"/><Button Name="TapeAddFile" Tag="A" Content="ADD LOCAL FILE"/></WrapPanel>
        <TextBlock Style="{StaticResource Note}" Text="AIFF becomes WAV with identical samples. MP3 works but is lossy and can fail to load. Games and their audio belong to their owners; the launcher fetches only the link you give it."/>
       </StackPanel>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource Frame}" Header="TAPE JOURNAL" BorderBrush="{DynamicResource C4}" Margin="0,12,0,0">
       <TextBox Name="TapeLog" Style="{StaticResource Log}" Height="140" Text="No tape played yet. Playback uses this PC's audio output only; it never opens a serial port or changes a disk image."/>
      </HeaderedContentControl>
     </StackPanel></ScrollViewer>
    </TabItem>

    <TabItem Header="8 FARGLADE" Name="FgTab">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
      <HeaderedContentControl Style="{StaticResource FrameDouble}" Header="FARGLADE OS / 6502 HEARTH + Z80 GLADE" BorderBrush="{DynamicResource C2}">
       <StackPanel>
        <TextBlock Name="FgVersionText" Text="FARGLADE OS" FontSize="34" TextWrapping="NoWrap"/>
        <TextBlock Margin="0,6,0,10" Text="Boots Farglade OS on an Apple IIe with a Premium SoftCard IIe and no disk drive, then serves it: every file and program, March Ash, the browser and IRC come over this serial link. Close ADTPro. At the ] prompt type IN# and the SSC slot, Return, then Ctrl+A, 14B, Return (9600 baud). Then boot."/>
        <WrapPanel><Button Name="FgBoot" Tag="B" Content="BOOT FARGLADE OS" Style="{StaticResource Primary}"/><Button Name="FgStop" Tag="X" Content="STOP / RELEASE PORT"/><Button Name="FgSave" Tag="V" Content="SAVE PROFILE SETTINGS"/></WrapPanel>
        <TextBlock Style="{StaticResource Note}" Text="The loader is typed into the Apple's monitor in about ten seconds, and the Apple has ninety to answer. Leave the session running while you use the Apple; stopping it leaves the Apple saying the uplink has gone quiet. Ctrl-Reset on the Apple returns to its monitor."/>
       </StackPanel>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource Frame}" Header="LINK &amp; OPTIONS" BorderBrush="{DynamicResource C1}" Margin="0,12,0,0">
       <StackPanel>
        <UniformGrid Columns="3"><StackPanel Margin="0,0,16,0"><TextBlock Text="PORT"/><TextBox Name="FgPortField"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="SSC SLOT"/><ComboBox Name="FgSlotField"/></StackPanel><StackPanel><TextBlock Text="LINK BAUD"/><ComboBox Name="FgBaudField"/></StackPanel></UniformGrid>
        <WrapPanel><CheckBox Name="FgReducedField" Content="REDUCED MOTION"/><CheckBox Name="FgMuteField" Content="START MUTED"/></WrapPanel>
        <TextBlock Style="{StaticResource Note}" Text="Reduced motion drops the typewriter delays and offers guest entry at the lock at once. The baud here is the link's working rate; the loader always goes in at 9600."/>
       </StackPanel>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource Frame}" Header="THE FAR ROADS / INTERNET FOR THE BROWSER AND IRC" BorderBrush="{DynamicResource C3}" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Margin="0,0,0,8" Text="Closed unless you open them here. Closed, the Apple's browser and IRC reach GladeNet and this PC only."/>
        <CheckBox Name="FgOpenRoads" Content="OPEN THE FAR ROADS TO ANY HOST, FOR THE NEXT BOOT"/>
        <UniformGrid Columns="2"><StackPanel Margin="0,0,16,0"><TextBlock Text="OR ONLY TO THESE HOSTS"/><TextBox Name="FgNetHostsField"/></StackPanel><StackPanel><TextBlock Text="MARCH ASH MODEL HOSTS BESIDES THIS PC"/><TextBox Name="FgRelayHostsField"/></StackPanel></UniformGrid>
        <TextBlock Style="{StaticResource Note}" Text="Host lists are names or addresses separated by commas, saved with the profile. The open-to-any-host box is not saved: it is unchecked every time the launcher starts. Pages are fetched read-only; IRC sends only what is typed on the Apple."/>
       </StackPanel>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource Frame}" Header="BUILD &amp; CHECK / NO SERIAL PORT" BorderBrush="{DynamicResource C5}" Margin="0,12,0,0">
       <StackPanel>
        <WrapPanel><Button Name="FgBuild" Tag="U" Content="BUILD FARGLADE OS"/><Button Name="FgCheck" Tag="C" Content="RUN PC CHECKS"/><Button Name="FgGuide" Tag="G" Content="OPERATING GUIDE"/><Button Name="FgFolder" Tag="F" Content="OPEN PROJECT FOLDER"/></WrapPanel>
        <TextBlock Name="FgWhere" Foreground="{DynamicResource Dim}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <TextBlock Style="{StaticResource Note}" Text="Farglade OS is its own project with its own version and changelog. Build makes the loader, both processors' code and the lore pack (about half a minute). The PC checks take about as long and use neither the Apple nor a port."/>
       </StackPanel>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource Frame}" Header="UPLINK JOURNAL" BorderBrush="{DynamicResource C4}" Margin="0,12,0,0">
       <TextBox Name="FgLog" Style="{StaticResource Log}" Height="190" Text="No Farglade session yet. Serial is closed."/>
      </HeaderedContentControl>
     </StackPanel></ScrollViewer>
    </TabItem>
   </TabControl>

   <Border Grid.Row="3" Height="2" Background="{DynamicResource Fg}" Margin="0,10,0,8"/>
   <DockPanel Grid.Row="4">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Name="MonitorCycle" Tag="M" Content="MONITOR: GREEN" Margin="0,0,10,0"/><Button Name="Stop" Tag="ESC" Content="STOP / RELEASE PORT" Margin="0"/></StackPanel>
    <WrapPanel VerticalAlignment="Center"><TextBlock Name="ProfileSummary" Margin="0,0,28,0" TextWrapping="NoWrap"/><TextBlock Name="PortSummary" Margin="0,0,28,0" TextWrapping="NoWrap"/><TextBlock Name="SessionState" Foreground="{DynamicResource Dim}" TextWrapping="NoWrap" Text="NO MANAGED SESSION"/></WrapPanel>
   </DockPanel>
   <Border Grid.Row="5" Background="{DynamicResource Bar}" Padding="10,2" Margin="0,8,0,0"><TextBlock Name="Status" Foreground="{DynamicResource OnBar}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="PRESS 1-8 FOR A SCREEN, M TO CHANGE MONITOR, OR A HIGHLIGHTED LETTER FOR ITS ACTION. NO SERIAL PORT HAS BEEN OPENED."/></Border>
  </Grid>
  <Rectangle Name="Scanlines" IsHitTestVisible="False">
   <Rectangle.Fill><LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,4" SpreadMethod="Repeat"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.5"/><GradientStop Color="#38000000" Offset="0.75"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
  </Rectangle>
 </Grid>
</Window>
