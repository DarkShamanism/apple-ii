<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Crowbar Launcher" Width="1260" Height="900" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="{DynamicResource Mono}" FontSize="22">
 <Window.Resources>
  <!-- Monitor palette. theme-ui.ps1 replaces these brushes from themes.json; Green is the fallback. -->
  <SolidColorBrush x:Key="Bg" Color="#060C06"/>
  <SolidColorBrush x:Key="Fg" Color="#41FF5F"/>
  <SolidColorBrush x:Key="Dim" Color="#2A9E3C"/>
  <SolidColorBrush x:Key="Sel" Color="#41FF5F"/>
  <SolidColorBrush x:Key="OnSel" Color="#060C06"/>
  <SolidColorBrush x:Key="Pri" Color="#41FF5F"/>
  <SolidColorBrush x:Key="OnPri" Color="#060C06"/>
  <SolidColorBrush x:Key="Key" Color="#41FF5F"/>
  <SolidColorBrush x:Key="OnKey" Color="#060C06"/>
  <SolidColorBrush x:Key="Bar" Color="#41FF5F"/>
  <SolidColorBrush x:Key="OnBar" Color="#060C06"/>
  <SolidColorBrush x:Key="Meter" Color="#41FF5F"/>
  <SolidColorBrush x:Key="C1" Color="#41FF5F"/>
  <SolidColorBrush x:Key="C2" Color="#41FF5F"/>
  <SolidColorBrush x:Key="C3" Color="#41FF5F"/>
  <SolidColorBrush x:Key="C4" Color="#41FF5F"/>
  <SolidColorBrush x:Key="C5" Color="#41FF5F"/>
  <FontFamily x:Key="Mono">Lucida Console</FontFamily>

  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource Dim}"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
  <Style x:Key="Leader" TargetType="Line"><Setter Property="X2" Value="1"/><Setter Property="Stretch" Value="Fill"/><Setter Property="Stroke" Value="{DynamicResource Dim}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeDashArray" Value="1 2"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="10,8,10,0"/></Style>

  <!-- Buttons: a Tag letter is drawn as the hotkey chip, as on the 80-column screens. -->
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Fg}"/>
   <Setter Property="Padding" Value="12,3"/><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Padding="{TemplateBinding Padding}">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border x:Name="Chip" Background="{DynamicResource Key}" Padding="5,0" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock x:Name="ChipText" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource OnKey}" TextWrapping="NoWrap"/></Border>
      <ContentPresenter VerticalAlignment="Center"/>
     </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Chip" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Fg}"/><Setter Property="Foreground" Value="{DynamicResource Bg}"/><Setter TargetName="Chip" Property="Background" Value="{DynamicResource Bg}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Fg}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource Fg}"/><Setter Property="Foreground" Value="{DynamicResource Bg}"/><Setter TargetName="Chip" Property="Background" Value="{DynamicResource Bg}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Fg}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Dim}"/><Setter Property="BorderBrush" Value="{DynamicResource Dim}"/><Setter Property="Cursor" Value="Arrow"/><Setter TargetName="Chip" Property="Background" Value="{DynamicResource Dim}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Bg}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource Pri}"/><Setter Property="Foreground" Value="{DynamicResource OnPri}"/><Setter Property="BorderBrush" Value="{DynamicResource Pri}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Padding="{TemplateBinding Padding}">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border x:Name="Chip" Background="{DynamicResource OnPri}" Padding="5,0" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock x:Name="ChipText" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource Pri}" TextWrapping="NoWrap"/></Border>
      <ContentPresenter VerticalAlignment="Center"/>
     </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Chip" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Bg}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="BorderBrush" Value="{DynamicResource Fg}"/><Setter TargetName="Chip" Property="Background" Value="{DynamicResource Key}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource OnKey}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource Bg}"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="BorderBrush" Value="{DynamicResource Fg}"/><Setter TargetName="Chip" Property="Background" Value="{DynamicResource Key}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource OnKey}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Dim}"/><Setter Property="BorderBrush" Value="{DynamicResource Dim}"/><Setter Property="Cursor" Value="Arrow"/><Setter TargetName="Chip" Property="Background" Value="{DynamicResource Dim}"/><Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Bg}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Data entry: underlined fields that turn inverse while you type. -->
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Dim}"/><Setter Property="BorderThickness" Value="0,0,0,2"/>
   <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/><Setter Property="SelectionBrush" Value="{DynamicResource Sel}"/><Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
   <Setter Property="Padding" Value="4,2"/><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,2,0,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource Sel}"/><Setter Property="Foreground" Value="{DynamicResource OnSel}"/><Setter Property="CaretBrush" Value="{DynamicResource OnSel}"/><Setter Property="BorderBrush" Value="{DynamicResource Sel}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Log" TargetType="TextBox">
   <Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="SelectionBrush" Value="{DynamicResource Sel}"/><Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="FontFamily" Value="{DynamicResource Mono}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="Row" Background="Transparent" Padding="8,2"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Sel}"/><Setter Property="Foreground" Value="{DynamicResource OnSel}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="FontFamily" Value="{DynamicResource Mono}"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0,2,0,8"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Line" Background="Transparent" BorderBrush="{DynamicResource Dim}" BorderThickness="0,0,0,2"><TextBlock Text="v" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Fg}"/></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Border x:Name="Field" Margin="0,0,24,2" IsHitTestVisible="False"><ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="4,2" VerticalAlignment="Center"/></Border>
     <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="0,0,24,0" IsReadOnly="{TemplateBinding IsReadOnly}"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
      <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Fg}" BorderThickness="2" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
       <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="Field" Property="Visibility" Value="Hidden"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="Background" Value="{DynamicResource Sel}"/><Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource OnSel}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="8,3" MinHeight="36"><ContentPresenter VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Fg}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Fg}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Sel}"/><Setter Property="Foreground" Value="{DynamicResource OnSel}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Dim}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="Margin" Value="0,6,24,6"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal" Background="Transparent">
     <Border Width="22" Height="22" BorderBrush="{DynamicResource Fg}" BorderThickness="2" VerticalAlignment="Center"><Rectangle x:Name="Mark" Margin="3" Fill="{DynamicResource Meter}" Visibility="Collapsed"/></Border>
     <Border x:Name="Label" Margin="10,0,0,0" Padding="4,0" VerticalAlignment="Center"><ContentPresenter VerticalAlignment="Center"/></Border>
    </StackPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Label" Property="Background" Value="{DynamicResource Sel}"/><Setter Property="Foreground" Value="{DynamicResource OnSel}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="Margin" Value="0,4"/><Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <DockPanel Background="Transparent">
     <Grid DockPanel.Dock="Left" Width="22" Height="22" VerticalAlignment="Center"><Ellipse Stroke="{DynamicResource Fg}" StrokeThickness="2"/><Ellipse x:Name="Mark" Margin="5" Fill="{DynamicResource Meter}" Visibility="Collapsed"/></Grid>
     <Border x:Name="Label" Margin="10,0,0,0" Padding="4,0" VerticalAlignment="Center"><ContentPresenter VerticalAlignment="Center"/></Border>
    </DockPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Label" Property="Background" Value="{DynamicResource Sel}"/><Setter Property="Foreground" Value="{DynamicResource OnSel}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SliderPad" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid MinHeight="28" VerticalAlignment="Center">
     <Border Height="4" Background="{DynamicResource Dim}" VerticalAlignment="Center"/>
     <Track x:Name="PART_Track">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderPad}"/></Track.DecreaseRepeatButton>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderPad}"/></Track.IncreaseRepeatButton>
      <Track.Thumb><Thumb Width="14" Height="26"><Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="{DynamicResource Meter}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ProgressBar">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Grid>
     <Border x:Name="PART_Track" BorderBrush="{DynamicResource Meter}" BorderThickness="1"/>
     <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" Margin="3">
      <Rectangle Fill="{DynamicResource Meter}"/>
      <!-- Black gaps turn the bar into tape-counter blocks. -->
      <Rectangle><Rectangle.Fill><LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="16,0" SpreadMethod="Repeat"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.8"/><GradientStop Color="#FF000000" Offset="0.8"/><GradientStop Color="#FF000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
     </Grid>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar"><Setter Property="Background" Value="{DynamicResource Bg}"/></Style>

  <!-- Menu bar: numbered screens, the current one in inverse video. -->
  <Style TargetType="TabControl">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
    <DockPanel>
     <WrapPanel DockPanel.Dock="Top" IsItemsHost="True"/>
     <Border DockPanel.Dock="Top" Height="2" Background="{DynamicResource Fg}" Margin="0,6,0,14"/>
     <ContentPresenter ContentSource="SelectedContent"/>
    </DockPanel>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource Fg}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" Padding="12,3" Margin="0,0,6,0" MinHeight="40"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Fg}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Fg}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource Sel}"/><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Sel}"/><Setter Property="Foreground" Value="{DynamicResource OnSel}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Windows with their title cut into the frame; FrameDouble marks the main window of a screen. -->
  <Style x:Key="Frame" TargetType="HeaderedContentControl">
   <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Fg}"/><Setter Property="Padding" Value="16,20,16,8"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="HeaderedContentControl">
    <Grid Margin="0,14,0,0">
     <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
     <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,-14,0,0" Padding="8,0" Background="{DynamicResource Bg}"><ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding BorderBrush}"/></Border>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FrameDouble" TargetType="HeaderedContentControl" BasedOn="{StaticResource Frame}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="HeaderedContentControl">
    <Grid Margin="0,14,0,0">
     <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"><Border Margin="3" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></Border>
     <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,-14,0,0" Padding="8,0" Background="{DynamicResource Bg}"><ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding BorderBrush}"/></Border>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid Name="Root" Margin="24,14,24,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="CROWBAR LAUNCHER" TextWrapping="NoWrap"/>
    <TextBlock Grid.Column="1" Text="APPLE IIe &lt;-&gt; PC COMPANION" Foreground="{DynamicResource Dim}" TextWrapping="NoWrap"/>
    <TextBlock Grid.Column="2" Name="VersionText" HorizontalAlignment="Right" TextWrapping="NoWrap"/>
   </Grid>
   <Grid Grid.Row="1" Margin="0,6,0,8">
    <Border Name="MonoRule" Height="8" BorderBrush="{DynamicResource Fg}" BorderThickness="0,2,0,2"/>
    <UniformGrid Name="ColorBand" Columns="16" Height="10" Visibility="Collapsed">
     <Rectangle Fill="#000000"/><Rectangle Fill="#9D1B6C"/><Rectangle Fill="#402CB8"/><Rectangle Fill="#D643FF"/><Rectangle Fill="#007A3D"/><Rectangle Fill="#808080"/><Rectangle Fill="#2F95FF"/><Rectangle Fill="#BFD7FF"/>
     <Rectangle Fill="#6F4F1F"/><Rectangle Fill="#FF6A00"/><Rectangle Fill="#C0C0C0"/><Rectangle Fill="#FFA0D0"/><Rectangle Fill="#2FD141"/><Rectangle Fill="#FFF04A"/><Rectangle Fill="#72FFB5"/><Rectangle Fill="#FFFFFF"/>
    </UniformGrid>
   </Grid>

   <TabControl Name="Tabs" Grid.Row="2">
    <TabItem Header="1 STREAM">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="8*"/></Grid.ColumnDefinitions>
       <HeaderedContentControl Style="{StaticResource Frame}" Header="PROFILE" BorderBrush="{DynamicResource C1}">
        <StackPanel>
         <ListBox Name="ProfileList" MaxHeight="190">
          <ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Baud}" Margin="16,0,0,0" TextWrapping="NoWrap"/><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
         </ListBox>
         <WrapPanel Margin="0,12,0,0"><Button Name="QuickLaunch" Tag="L" Content="LAUNCH PROFILE" Style="{StaticResource Primary}"/><Button Name="QuickDemo" Tag="D" Content="QUICK DEMO"/></WrapPanel>
         <TextBlock Style="{StaticResource Note}" Text="Adjust profiles on screen 2. Launching uses the settings shown there, including unsaved edits."/>
        </StackPanel>
       </HeaderedContentControl>
       <HeaderedContentControl Grid.Column="2" Style="{StaticResource FrameDouble}" Header="STREAMING DESK" BorderBrush="{DynamicResource C2}">
        <StackPanel>
         <StackPanel Orientation="Horizontal">
          <TextBlock Name="SessionTitle" Text="READY." FontSize="46" TextWrapping="NoWrap"/>
          <Rectangle Name="ReadyCursor" Width="20" Height="32" Margin="10,4,0,0" VerticalAlignment="Center" Fill="{DynamicResource Fg}">
           <Rectangle.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.06" RepeatBehavior="Forever"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/><DiscreteDoubleKeyFrame KeyTime="0:0:0.53" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></EventTrigger></Rectangle.Triggers>
          </Rectangle>
         </StackPanel>
         <TextBlock Name="SessionDetail" Text="Load the receiver, choose a profile, and bring your world to the Apple II." Margin="0,8,0,14"/>
         <UniformGrid Columns="3">
          <StackPanel Margin="0,0,16,0"><TextBlock Text="VIDEO" Foreground="{DynamicResource Dim}"/><TextBlock Name="VideoSummary"/></StackPanel>
          <StackPanel Margin="0,0,16,0"><TextBlock Text="LINK" Foreground="{DynamicResource Dim}"/><TextBlock Name="LinkSummary"/></StackPanel>
          <StackPanel><TextBlock Text="CAPTURE" Foreground="{DynamicResource Dim}"/><TextBlock Name="SourceSummary"/></StackPanel>
         </UniformGrid>
        </StackPanel>
       </HeaderedContentControl>
      </Grid>
      <HeaderedContentControl Style="{StaticResource Frame}" Header="DISK &amp; SERIAL HANDOFF" BorderBrush="{DynamicResource C3}" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="Open ADTPro to load the receiver. Once the IIe says WAITING FOR STREAM, hand the port to your profile." Margin="0,0,0,10"/>
        <WrapPanel><Button Name="LaunchAdt" Tag="A" Content="OPEN ADTPRO"/><Button Name="HandoffStream" Tag="H" Content="CLOSE ADTPRO &amp; STREAM"/><Button Name="HandoffAdt" Tag="B" Content="STOP STREAM &amp; OPEN ADTPRO"/></WrapPanel>
        <TextBlock Style="{StaticResource Note}" Text="Finish disk transfers before closing ADTPro. For the return trip, press Esc on the IIe to restore 19200 baud. Choose Serial and the port in ADTPro itself."/>
       </StackPanel>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource Frame}" Header="VSDRIVE DEPLOY" BorderBrush="{DynamicResource C5}" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="Put this release's receivers into the VSDRIVE image ADTPro serves, so the IIe can BRUN them after a SpeediBoot. Close ADTPro first." Margin="0,0,0,10"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="VSDRIVE IMAGE (.PO)"/><TextBox Name="VsImageField"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="RECEIVERS"/><ComboBox Name="VsSetField" MinWidth="220"/></StackPanel>
        </Grid>
        <WrapPanel Margin="0,10,0,0"><Button Name="VsDeploy" Tag="V" Content="DEPLOY TO VSDRIVE" Style="{StaticResource Primary}"/><Button Name="VsBrowse" Tag="I" Content="CHOOSE IMAGE"/><Button Name="VsRestore" Tag="R" Content="RESTORE LAST BACKUP"/></WrapPanel>
        <TextBlock Style="{StaticResource Note}" Text="The image is backed up first and replaced only after every file reads back from the first directory block, where SpeediBoot looks. Then: BRUN A2MC.RX,S1,D2. Backups go to build\&lt;version&gt;\launcher\vsdrive-backups."/>
       </StackPanel>
      </HeaderedContentControl>
